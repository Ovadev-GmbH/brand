{
  "name": "@ovadev-gmbh/ui-internal",
  "version": "1.0.0",
  "description": "Ovadev's design system in light mode, for Ovadev's internal tools: re-exports @ovadev-gmbh/ui-ovadev and keeps the --int-* names.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./styles.css": "./src/styles.css",
    "./theme.css": "./src/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ovadev-GmbH/brand.git",
    "directory": "packages/internal"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "bun run ../../scripts/gen-internal.ts && vite build && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4"
  },
  "dependencies": {
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@ovadev-gmbh/ui-ovadev": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
