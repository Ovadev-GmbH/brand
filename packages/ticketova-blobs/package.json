{
  "name": "@ovadev-gmbh/ticketova-blobs",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic blob avatars for TICKETOVA: one flat grey silhouette and two strokes for eyes, from any string.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ovadev-GmbH/brand.git",
    "directory": "packages/ticketova-blobs"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "scripts": {
    "build": "bun build src/index.ts src/react.tsx --outdir dist --target browser --format esm --splitting --external react --external react/jsx-runtime && tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "demo": "bun run demo/serve.ts"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "react": "^19.2.8",
    "typescript": "^5.9.3"
  }
}
